# Environment used by the automated integration test suite (`npm test`).
# This file is committed on purpose: it contains only local test defaults
# and a throwaway JWT secret that must never be used in production.
# The test database is created automatically if it does not exist.

NODE_ENV=test
PORT=3000

# Dedicated test database - MUST differ from the development database.
DATABASE_URL="postgresql://clinic_app:Clinic%402026@localhost:5432/clinic_booking_test"

JWT_SECRET="test-only-secret-key-for-the-integration-test-suite-32+"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Raised ceilings so a full suite run from one IP is not rate-limited.
RATE_LIMIT_LOGIN_MAX=1000
RATE_LIMIT_REGISTER_MAX=1000
RATE_LIMIT_REFRESH_MAX=1000
