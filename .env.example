# Server Environment
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://clinic_app:Clinic%402026@localhost:5432/clinic_booking"

# JWT Authentication
# Must be at least 32 characters long
JWT_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS Configuration
# For local frontend development, set to your frontend dev URL (e.g. Vite: http://localhost:5173, Next.js: http://localhost:3000)
# Use '*' for allowing all origins in local testing
CORS_ORIGIN="*"

# Rate Limiting (per IP window)
RATE_LIMIT_LOGIN_MAX="10"       # 10 requests per 15 minutes
RATE_LIMIT_REGISTER_MAX="5"     # 5 requests per 1 hour
RATE_LIMIT_REFRESH_MAX="20"     # 20 requests per 15 minutes

