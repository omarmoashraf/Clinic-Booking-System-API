// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.VarChar(255)
  password_hash String   @db.VarChar(255)
  full_name     String   @db.VarChar(150)
  phone         String?  @db.VarChar(30)
  role          Role
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  doctor  Doctor?
  patient Patient?
}

model Specialty {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  doctors    Doctor[]
}

model Doctor {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String         @unique @db.Uuid
  user           User           @relation(fields: [user_id], references: [id])
  specialty_id   String         @db.Uuid
  specialty      Specialty      @relation(fields: [specialty_id], references: [id])
  bio            String?        @db.Text
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @default(now()) @db.Timestamptz(6)
  appointments   Appointment[]
  availabilities Availability[]
}

model Patient {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @unique @db.Uuid
  date_of_birth DateTime? @db.Date
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id])

  appointments Appointment[]
}

model Availability {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctor_id   String             @db.Uuid
  doctor      Doctor             @relation(fields: [doctor_id], references: [id])
  date        DateTime           @db.Date
  start_time  DateTime           @db.Time()
  end_time    DateTime           @db.Time()
  status      AvailabilityStatus @default(AVAILABLE)
  created_at  DateTime           @default(now()) @db.Timestamptz(6)
  updated_at  DateTime           @default(now()) @db.Timestamptz(6)
  appointment Appointment?

  @@index([doctor_id, date])
}

model Appointment {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  availability_id String            @unique @db.Uuid
  availability    Availability      @relation(fields: [availability_id], references: [id])
  doctor_id       String            @db.Uuid
  doctor          Doctor            @relation(fields: [doctor_id], references: [id])
  patient_id      String            @db.Uuid
  patient         Patient           @relation(fields: [patient_id], references: [id])
  status          AppointmentStatus @default(PENDING)
  notes           String?           @db.Text
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)

  @@index([patient_id])
  @@index([doctor_id])
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}
